# Copy to .env and replace every change-me value. Never commit .env.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=reqlens
# Local development only: fall back to temporary memory storage when MongoDB is offline.
ALLOW_IN_MEMORY_DB=false
JWT_SECRET=change-me-use-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
OPENAI_API_KEY=
TAVILY_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=15
AI_ENABLED=true

